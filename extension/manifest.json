{
  "manifest_version": 3,
  "name": "Bookmark Glass",
  "version": "1.0.0",
  "description": "Minimal glassmorphic browser bookmark manager, personal library, and article reading tracker.",
  "permissions": [
    "bookmarks",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "favicon"
  ],
  "action": {
    "default_title": "Bookmark Glass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Bookmark Glass dashboard"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
